<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <View
            android:id="@+id/headerBackground"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/primary_blue"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvWelcome"
            style="@style/TextAppearance.NimmaGuru.HeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="32dp"
            android:text="Namaste"
            android:textColor="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/community_mentorship"
            android:textColor="#E0E0E0"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="@+id/tvWelcome"
            app:layout_constraintTop_toBottomOf="@+id/tvWelcome" />

        <!-- Wall of Fame Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWallOfFame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:strokeWidth="2dp"
            app:strokeColor="@color/accent_orange"
            app:cardBackgroundColor="#FFFDE7"
            app:layout_constraintTop_toBottomOf="@+id/tvSubHeader">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">
                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="@color/accent_orange"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wall of Fame"
                        android:textStyle="bold"
                        android:textSize="22sp"
                        android:textColor="#F57F17"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meet our Top Gurus"
                        android:textSize="16sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main Actions with Large Buttons -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/cardWallOfFame">

            <Button
                android:id="@+id/btnSearchGuru"
                style="@style/Widget.NimmaGuru.Button.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/search_guru"
                app:icon="@android:drawable/ic_menu_search" />

            <Button
                android:id="@+id/btnViewCalendar"
                style="@style/Widget.NimmaGuru.Button.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/view_calendar"
                android:backgroundTint="@color/secondary_green"
                app:icon="@android:drawable/ic_menu_my_calendar" />

            <Button
                android:id="@+id/btnProfile"
                style="@style/Widget.NimmaGuru.Button.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="My Profile"
                android:backgroundTint="@color/accent_orange"
                app:icon="@android:drawable/ic_menu_edit" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/Widget.NimmaGuru.Button.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Settings"
                android:backgroundTint="@color/text_secondary"
                app:icon="@android:drawable/ic_menu_preferences" />

            <Button
                android:id="@+id/btnLogout"
                style="@style/Widget.NimmaGuru.Button.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/logout"
                android:backgroundTint="@color/error_red"
                app:icon="@android:drawable/ic_lock_power_off" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
